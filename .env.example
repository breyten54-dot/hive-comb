# Copy to .env.local for `vercel dev`. NEVER commit real values.
# Create the token at https://www.notion.so/my-integrations (internal integration),
# then share BOTH HIVE databases with it: database -> ... -> Connections -> add.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional - defaults are the live HIVE databases, only set to override.
# NOTION_TASKS_DB=0dc4a16399414e0087faf4105a9205c7
# NOTION_PROJECTS_DB=a3f251c46daf43339c585f72bda63d8c
